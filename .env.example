# ---------------------------------------------------------------------------
# TiendaFlow — variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NINGUNA de estas claves se expone al cliente: todas se leen en el servidor.
# ---------------------------------------------------------------------------

# Secreto usado para firmar la cookie de sesión. Obligatorio en producción.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TIENDAFLOW_SESSION_SECRET=

# Clave para cifrar las credenciales de terceros (access token de Mercado Pago,
# secret key de Stripe, token de Meta) antes de guardarlas. Obligatoria en
# producción. Si la perdés, esas credenciales se vuelven ilegibles y hay que
# volver a cargarlas.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TIENDAFLOW_ENCRYPTION_KEY=

# Ubicación del archivo SQLite (por defecto ./data/tiendaflow.db)
TIENDAFLOW_DB_PATH=

# URL pública del sitio. Se usa para armar las URLs absolutas de las imágenes
# que se muestran al compartir un link (por defecto http://localhost:3000).
TIENDAFLOW_SITE_URL=

# --- Proveedor de IA (opcional) --------------------------------------------
# Se usa el primero que esté configurado: Anthropic y después Gemini. Sin
# ninguno, TiendaFlow arma borradores locales y lo indica en la UI.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini. La clave se saca de Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Mercado Pago: conectar cuentas con un botón (OAuth) -------------------
# Son las credenciales de LA PLATAFORMA, no las de un vendedor. Se cargan una
# sola vez. Con esto, cada vendedor conecta su cuenta apretando un botón en vez
# de buscar y pegar un access token a mano.
#
# Dónde salen: entrá a mercadopago.com.ar/developers con la cuenta de
# TiendaFlow, creá una aplicación y copiá su Client ID y Client Secret. En la
# misma pantalla hay que cargar la "Redirect URI" de abajo, EXACTAMENTE igual.
#
# Sin estas variables la app sigue andando: la pantalla de Pagos vuelve al
# camino manual y lo dice.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Opcional. Por defecto se arma como <TIENDAFLOW_SITE_URL>/api/oauth/mercadopago/callback.
# Definila a mano si hay un proxy adelante y el host que ve la app no es el que
# ve el navegador. Tiene que coincidir carácter por carácter con la del panel.
MERCADOPAGO_REDIRECT_URI=

# --- Postgres / Supabase (opcional, para deploy con el schema de supabase/) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
