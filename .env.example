# ---------------------------------------------------------------------------
# TiendaFlow — variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NINGUNA de estas claves se expone al cliente: todas se leen en el servidor.
# ---------------------------------------------------------------------------

# Secreto usado para firmar la cookie de sesión. Obligatorio en producción.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TIENDAFLOW_SESSION_SECRET=

# Clave para cifrar las credenciales de terceros (access token de Mercado Pago,
# secret key de Stripe, token de Meta) antes de guardarlas. Obligatoria en
# producción. Si la perdés, esas credenciales se vuelven ilegibles y hay que
# volver a cargarlas.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TIENDAFLOW_ENCRYPTION_KEY=

# Ubicación del archivo SQLite (por defecto ./data/tiendaflow.db)
TIENDAFLOW_DB_PATH=

# URL pública del sitio. Se usa para armar las URLs absolutas de las imágenes
# que se muestran al compartir un link (por defecto http://localhost:3000).
TIENDAFLOW_SITE_URL=

# --- Proveedor de IA (opcional) --------------------------------------------
# Se usa el primero que esté configurado: Anthropic y después Gemini. Sin
# ninguno, TiendaFlow arma borradores locales y lo indica en la UI.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini. La clave se saca de Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Mercado Pago: conectar cuentas con un botón (OAuth) -------------------
# Son las credenciales de LA PLATAFORMA, no las de un vendedor. Se cargan una
# sola vez. Con esto, cada vendedor conecta su cuenta apretando un botón en vez
# de buscar y pegar un access token a mano.
#
# Dónde salen: entrá a mercadopago.com.ar/developers con la cuenta de
# TiendaFlow, creá una aplicación y copiá su Client ID y Client Secret. En la
# misma pantalla hay que cargar la "Redirect URI" de abajo, EXACTAMENTE igual.
#
# Sin estas variables la app sigue andando: la pantalla de Pagos vuelve al
# camino manual y lo dice.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Opcional. Por defecto se arma como <TIENDAFLOW_SITE_URL>/api/oauth/mercadopago/callback.
# Definila a mano si hay un proxy adelante y el host que ve la app no es el que
# ve el navegador. Tiene que coincidir carácter por carácter con la del panel.
MERCADOPAGO_REDIRECT_URI=

# --- Cobro del abono de TiendaFlow (opcional) -------------------------------
# Son las credenciales de LA PLATAFORMA cobrándole el abono a sus usuarios. No
# confundir con MERCADOPAGO_CLIENT_ID/SECRET de arriba, que son para que cada
# vendedor conecte SU cuenta y cobre SUS ventas. Acá el que cobra es TiendaFlow.
#
# Sin esto la app no se rompe: la pantalla de Planes avisa que el cobro no está
# configurado y no deja pasar a un plan pago.

# Stripe — el camino principal. Los planes están en dólares y Stripe los cobra
# en dólares desde cualquier tarjeta del mundo, así que el precio que se
# publica es exactamente el que se debita.
# La secret key sale de dashboard.stripe.com/apikeys (cuenta de TiendaFlow).
TIENDAFLOW_BILLING_STRIPE_SECRET_KEY=
# La firma del endpoint /api/webhooks/billing/stripe, que se da de alta en
# dashboard.stripe.com/webhooks. Eventos: checkout.session.completed,
# customer.subscription.*, invoice.payment_failed, invoice.payment_succeeded.
TIENDAFLOW_BILLING_STRIPE_WEBHOOK_SECRET=
# Días de prueba antes del primer cobro. Vacío o 0 = se cobra al suscribirse.
TIENDAFLOW_BILLING_TRIAL_DAYS=
#
# Opcional: si querés manejar los precios desde el panel de Stripe en vez de
# desde plans.ts, pegá acá el Price ID (price_...) de cada plan pago. Cuando
# están cargados, antes de mandar a nadie al checkout se le pregunta a Stripe
# cuánto cobra ese precio y se corta si no coincide con plans.ts: publicar US$9
# y debitar US$20 no puede pasar en silencio.
TIENDAFLOW_BILLING_STRIPE_PRICE_CREATOR=
TIENDAFLOW_BILLING_STRIPE_PRICE_PRO=

# Mercado Pago — el camino alternativo, para quien no tiene tarjeta que pueda
# pagar en dólares. Mercado Pago solo debita en la moneda del país de la cuenta
# que cobra, así que el importe sale de convertir el precio en dólares con la
# cotización de abajo, y queda congelado hasta que se actualice.
TIENDAFLOW_BILLING_MP_ACCESS_TOKEN=
# Cuántas unidades de la moneda local vale un dólar. Es un número a mano y no
# una API de cambio a propósito: el precio que se le cobra a alguien no puede
# depender de que un servicio de terceros esté arriba en ese instante.
TIENDAFLOW_BILLING_USD_RATE=
# La moneda en la que puede debitar esa cuenta. Por defecto ARS.
TIENDAFLOW_BILLING_CURRENCY=
# La firma del endpoint /api/webhooks/billing/mercadopago.
TIENDAFLOW_BILLING_MP_WEBHOOK_SECRET=

# --- Postgres / Supabase (opcional, para deploy con el schema de supabase/) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
